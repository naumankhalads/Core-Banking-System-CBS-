# Database Configuration
# Choose one of the following options:

# Option 1: Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=core_banking_system

# Option 2: PlanetScale (MySQL compatible)
# DB_HOST=xxxxx.us-east-2.psdb.cloud
# DB_USER=xxxxx
# DB_PASSWORD=xxxxx
# DB_NAME=core_banking_system
# DATABASE_URL=mysql://xxxxx:xxxxx@xxxxx.us-east-2.psdb.cloud/core_banking_system

# Option 3: Cloud Database URL
# DATABASE_URL=mysql://user:password@host:port/database_name

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Sync (use with caution)
SYNC_DB=false
FORCE_SYNC=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Admin User Setup
ADMIN_EMAIL=admin@corebanking.com
ADMIN_PASSWORD=Admin@12345
