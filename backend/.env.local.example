# Local Development Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# PostgreSQL / Supabase Connection
# Get these from: https://app.supabase.com -> Your Project -> Settings -> Database
POSTGRES_HOST=your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password
POSTGRES_DATABASE=postgres
POSTGRES_SSL=true

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Sync (set to 'true' only on first setup to create tables)
SYNC_DB=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Admin User (created on first sync)
ADMIN_EMAIL=admin@corebanking.com
ADMIN_PASSWORD=Admin@12345
